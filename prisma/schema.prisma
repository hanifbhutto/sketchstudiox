generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique // Foreign key linked to User model (Optional for guest carts)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  
  frame     String?  @default("Ebony Hardwood & Museum Mat")
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String   // Hashed password via bcrypt
  phone     String?  // Customer phone number
  address   String?  @db.Text // Archival shipping address
  city      String?
  country   String? 
  cart      Cart?    @relation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String
  type        String      @default("Gallery") // "Gallery" or "Commission"
  userId      String?     // Optional for guest checkouts
  email       String      // Patron contact email
  name        String
  address     String
  city        String
  postalCode  String
  country     String
  totalAmount Float
  status      String      @default("Pending") // Pending, Confirmed, Shipped, Photo Ingested
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Gallery items require artworkId; Custom Commissions leave artworkId null and use direct fields below
  artworkId String?  
  artwork   Artwork? @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  
  // Direct fields for Custom Commissions (bypassing fake artwork records)
  title       String?  // e.g. "Bespoke Portrait (2 Subjects)"
  medium      String?  // e.g. "Raw Willow Charcoal"
  substrate   String?  // e.g. "300 GSM French Cotton Substrate"
  dimensions  String?  // e.g. "A3 (12×16 in)"
  description String?  @db.Text // Composition directives & notes

  // Media relation for Commission reference photo
  mediaId     String?  @db.Uuid
  media       Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  frame     String?
  price     Float
  quantity  Int      @default(1)
}

// 2. EXHIBITION ARTWORKS (Gallery Vault Inventory - Strictly 100% Gallery Only)
model Artwork {
  id          String   @id // e.g. "ssx-01"
  title       String
  category    String   // "Human Portraits", "Pet & Animal Portraits", etc.
  medium      String
  substrate   String   // "300 GSM Arches Pure French Cotton"
  price       Float
  dimensions  String
  status      String   @default("Available Original") // "Available Original" | "Sold & Archived"
  year        String   @default("2026")
  edition     String   @default("1-of-1 Master Original")
  description String   @db.Text
  isColor     Boolean  @default(false)
  orderItems  OrderItem[]
  mediaId     String?  @db.Uuid
  media       Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  cartItems   CartItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 3. PRICING RATE MATRIX (Flyer Grid: Size x Subject Count)
model PricingRate {
  id           Int      @id @default(autoincrement())
  canvasSize   String   // "A4 (8×12 in)", "A3 (12×16 in)", etc.
  subjectCount Int      // 1 to 10
  price        Float    // Base USD rate
  createdAt    DateTime @default(now())

  @@unique([canvasSize, subjectCount])
}

// 4. STUDIO PREFERENCES & SETTINGS
model StudioSettings {
  id                        String   @id @default(uuid())
  studioEmail               String   @default("info@sketchstudiox.com")
  companyName               String   @default("SKETCH X STUDIO LTD")
  companyNumber             String   @default("17429707")
  incorporationJurisdiction String   @default("England and Wales (UK)")
  currency                  String   @default("USD")
  paypalClientId            String   @default("sb-client-id-sample-token-ssx")
  paypalEnv                 String   @default("sandbox")
  turnaroundDays            String   @default("7 - 14 Business Days")
  acceptingCommissions      Boolean  @default(true)
  autoConfirmOrders         Boolean  @default(true)
  logoMediaId               String?  @db.Uuid
  logoMedia                 Media?   @relation(fields: [logoMediaId], references: [id], onDelete: SetNull)
  updatedAt                 DateTime @updatedAt
}

model Media {
  id             String           @id @default(uuid()) @db.Uuid
  publicId       String           @unique @map("public_id")
  secureUrl      String           @map("secure_url")
  filename       String?
  createdAt      DateTime         @default(now()) @map("created_at")
  artworks       Artwork[]
  orderItems     OrderItem[]      // Added relation for commission media tracking
  studioSettings StudioSettings[] @relation
  @@map("media")
}